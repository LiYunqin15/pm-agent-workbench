# Required for live agent runs. Keep the real value in .env.local.
OPENAI_API_KEY=

# Optional OpenAI-compatible relay endpoint. Include its /v1 path when required.
OPENAI_BASE_URL=

# Use responses when the relay supports /v1/responses; otherwise use chat_completions.
OPENAI_API_MODE=responses

# Optional model overrides.
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_DEFAULT=gpt-5.6-terra
OPENAI_MODEL_DEEP=gpt-5.6-sol

# Optional pricing overrides for custom model IDs. Values are USD per 1M tokens.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_CACHED_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=

# Optional hosted-tool and trace controls.
OPENAI_WEB_SEARCH_COST_PER_CALL=0.01
OPENAI_AGENTS_TRACING_ENABLED=false

# Optional local workspace database path. Defaults to data/pm-agent.sqlite.
PM_AGENT_DB_PATH=

# Redis 6.2+ queue for asynchronous task execution. A running Redis is required in live mode.
PM_AGENT_REDIS_URL=redis://127.0.0.1:6379
PM_AGENT_QUEUE_NAME=pm-agent-runs
PM_AGENT_WORKER_CONCURRENCY=2
PM_AGENT_WORKER_ID=
PM_AGENT_RUN_TIMEOUT_QUICK_MS=90000
PM_AGENT_RUN_TIMEOUT_STANDARD_MS=240000
PM_AGENT_RUN_TIMEOUT_DEEP_MS=295000
